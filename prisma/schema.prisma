generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ResStatus {
  PENDING
  ASSIGNED
  COMPLETED
  R_RECEIVED
}

enum EmailDirection {
  INCOMING
  OUTGOING
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum DriverPaymentMethod {
  CASH
  BANK
  OTHER
}

enum DriverSubscriptionPaymentStatus {
  UNVERIFIED
  UNPAID
  PAID
}

enum DriverVehicleType {
  VAN
  SEDAN
}

enum AiActionType {
  UPDATE_RESERVATION
  ASSIGN_DRIVER
  CLEAR_DRIVER
  UPDATE_RESERVATION_COMMISSION
  ADD_MANUAL_COMMISSION
  RECORD_DRIVER_PAYMENT
  CREATE_RESERVATION
  IMPORT_DRIVERS
}

enum AiActionRisk {
  READ
  WRITE
  FINANCIAL_WRITE
  DESTRUCTIVE
}

enum AiActionStatus {
  PENDING
  EXECUTING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
  CONFLICTED
}

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  password                 String?
  name                     String?
  role                     Role       @default(USER)
  status                   UserStatus @default(ACTIVE)
  settingsPinHash          String?
  settingsPinFailedAttempts Int       @default(0)
  settingsPinLockedUntil   DateTime?
  createdAt                DateTime   @default(now())

  // Relations
  reservations          Reservation[]
  reminders             Reminder[]
  aiPendingActions      AiPendingAction[]
  aiWorkflowDrafts      AiWorkflowDraft[]
  recordedSubscriptions DriverSubscriptionCharge[] @relation("SubscriptionRecordedBy")
  deviceSessions        DeviceSession[]            @relation("DeviceSessionOwner")
  revokedDeviceSessions DeviceSession[]            @relation("DeviceSessionRevoker")
}

model DeviceSession {
  id                 String    @id @default(uuid())
  userId             String
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByUserId    String?
  revokeReason       String?   @db.VarChar(40)
  userAgent          String?   @db.VarChar(512)
  device             String    @db.VarChar(40)
  browser            String    @db.VarChar(40)
  os                 String    @db.VarChar(40)
  ipAddress          String?   @db.VarChar(45)
  networkCity        String?   @db.VarChar(80)
  networkRegion      String?   @db.VarChar(80)
  networkCountry     String?   @db.VarChar(80)
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  locationCapturedAt DateTime?
  locationVerifiedAt DateTime?
  settingsUnlockedUntil DateTime?

  user      User  @relation("DeviceSessionOwner", fields: [userId], references: [id], onDelete: Restrict)
  revokedBy User? @relation("DeviceSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AiWorkflowDraft {
  id          String   @id @default(cuid())
  userId      String
  kind        String   @db.VarChar(40)
  payloadJson Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([expiresAt])
}

model AiPendingAction {
  id                String         @id @default(cuid())
  userId            String
  actionType        AiActionType
  riskLevel         AiActionRisk
  status            AiActionStatus @default(PENDING)
  payloadJson       Json
  previewJson       Json
  preconditionJson  Json
  confirmationLabel String         @db.VarChar(120)
  idempotencyKey    String         @unique
  expiresAt         DateTime
  confirmedAt       DateTime?
  executedAt        DateTime?
  resultJson        Json?
  failureCode       String?        @db.VarChar(64)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model Reservation {
  id        String @id @default(cuid())
  userEmail String
  user      User   @relation(fields: [userEmail], references: [email])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  startAt     DateTime
  endAt       DateTime?
  pickupText  String?
  dropoffText String?
  pax         Int       @default(1)
  priceEuro   Float? // <- keep FLOAT to match prod
  notes       String?

  phone  String? @db.VarChar(40)
  flight String? @db.VarChar(40)

  status    ResStatus @default(PENDING)
  isDeleted Boolean   @default(false) // ✅ added field

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders         Reminder[]
  commissionEntries CommissionEntry[]

  @@index([driverId])
}

model Driver {
  id                 String             @id @default(cuid())
  name               String
  licenseNumber      String
  vehicleType        DriverVehicleType?
  subscriptionExempt Boolean            @default(false)
  status             DriverStatus       @default(ACTIVE)
  // Soft-delete marker. A non-null value hides the driver from every
  // operational surface (lists, selectors, reports, subscription generation)
  // while preserving all historical financial, reservation and audit records.
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reservations        Reservation[]
  commissionEntries   CommissionEntry[]
  payments            DriverPayment[]
  subscriptionCharges DriverSubscriptionCharge[]

  @@index([licenseNumber])
  @@index([deletedAt])
}

model CommissionEntry {
  id                   String   @id @default(cuid())
  driverId             String
  reservationId        String?  @unique
  subscriptionChargeId String?  @unique
  manualPickupText     String?
  manualDropoffText    String?
  commissionAmount     Decimal  @db.Decimal(10, 2)
  entryDate            DateTime
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  driver             Driver                    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  reservation        Reservation?              @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  subscriptionCharge DriverSubscriptionCharge? @relation("SubscriptionLiability", fields: [subscriptionChargeId], references: [id], onDelete: Restrict)

  @@index([driverId, entryDate])
}

model DriverPayment {
  id          String              @id @default(cuid())
  driverId    String
  paymentDate DateTime
  amount      Decimal             @db.Decimal(10, 2)
  method      DriverPaymentMethod
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  driver                  Driver                                @relation(fields: [driverId], references: [id], onDelete: Restrict)
  subscriptionAllocations DriverSubscriptionPaymentAllocation[]

  @@index([driverId, paymentDate])
}

model DriverSubscriptionCharge {
  id              String                          @id @default(cuid())
  driverId        String
  chargeMonth     DateTime                        @db.Date
  amount          Decimal                         @db.Decimal(10, 2)
  paymentStatus   DriverSubscriptionPaymentStatus @default(UNPAID)
  paidAt          DateTime?                       @db.Date
  paidByUserId    String?
  paymentNote     String?                         @db.VarChar(500)
  paymentRevision Int                             @default(0)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  driver              Driver                                @relation(fields: [driverId], references: [id], onDelete: Restrict)
  paidByUser          User?                                 @relation("SubscriptionRecordedBy", fields: [paidByUserId], references: [id], onDelete: Restrict)
  paymentAllocations  DriverSubscriptionPaymentAllocation[]
  liabilityCommission CommissionEntry?                      @relation("SubscriptionLiability")

  @@unique([driverId, chargeMonth])
  @@index([chargeMonth])
}

model DriverSubscriptionPaymentAllocation {
  id                   String   @id @default(cuid())
  driverPaymentId      String
  subscriptionChargeId String
  amount               Decimal  @db.Decimal(10, 2)
  createdAt            DateTime @default(now())

  driverPayment      DriverPayment            @relation(fields: [driverPaymentId], references: [id], onDelete: Cascade)
  subscriptionCharge DriverSubscriptionCharge @relation(fields: [subscriptionChargeId], references: [id], onDelete: Restrict)

  @@unique([driverPaymentId, subscriptionChargeId], map: "DriverSubscriptionAllocation_payment_charge_key")
  @@index([subscriptionChargeId])
}

model Reminder {
  id        String @id @default(cuid())
  userEmail String
  user      User   @relation(fields: [userEmail], references: [email])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  title  String
  note   String?
  dueAt  DateTime
  isDone Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, dueAt])
}

model EmailThread {
  id            String         @id @default(cuid())
  subject       String?
  customerEmail String?
  customerName  String?
  lastMessageAt DateTime?
  unread        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      EmailMessage[]

  @@index([lastMessageAt])
  @@index([unread, lastMessageAt])
}

model EmailMessage {
  id           String            @id @default(cuid())
  threadId     String
  messageId    String            @unique
  inReplyTo    String?
  referenceIds String[]          @default([])
  fromEmail    String?
  fromName     String?
  toEmails     String?
  ccEmails     String?
  subject      String?
  bodyHtml     String?
  bodyText     String?
  direction    EmailDirection
  folder       String?
  folders      String[]          @default([])
  mailbox      String?
  mailboxes    String[]          @default([])
  imapUid      Int?
  receivedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  thread       EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments  EmailAttachment[]

  @@index([threadId, receivedAt])
  @@index([threadId, sentAt])
  @@index([inReplyTo])
  @@index([folder, createdAt])
  @@index([folders], type: Gin)
  @@index([mailbox, imapUid])
  @@index([mailboxes], type: Gin)
}

model EmailAttachment {
  id          String       @id @default(cuid())
  messageId   String
  filename    String
  mimeType    String?
  size        Int?
  storagePath String?
  createdAt   DateTime     @default(now())
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model EmailSyncState {
  id          String   @id @default(cuid())
  mailbox     String   @unique
  uidValidity BigInt
  lastUid     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  userEmail  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userEmail])
  @@index([entityType])
  @@index([action])
}

// Durable global switches. A single seeded row (id = "global") controls whether
// the automatic monthly driver-subscription generator may create charges. The
// row is always present so it can serialize pause-vs-generate via SELECT ... FOR
// UPDATE. updatedByUserId is denormalized (no FK), like ActivityLog.userEmail.
model SubscriptionAutomationSetting {
  id              String   @id
  enabled         Boolean  @default(true)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}
