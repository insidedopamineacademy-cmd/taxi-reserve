generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ResStatus {
  PENDING
  ASSIGNED
  COMPLETED
  R_RECEIVED
}

enum EmailDirection {
  INCOMING
  OUTGOING
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum DriverPaymentMethod {
  CASH
  BANK
  OTHER
}

enum DriverVehicleType {
  VAN
  SEDAN
}

enum AiActionType {
  UPDATE_RESERVATION
  ASSIGN_DRIVER
  CLEAR_DRIVER
  UPDATE_RESERVATION_COMMISSION
  ADD_MANUAL_COMMISSION
  RECORD_DRIVER_PAYMENT
  CREATE_RESERVATION
  IMPORT_DRIVERS
}

enum AiActionRisk {
  READ
  WRITE
  FINANCIAL_WRITE
  DESTRUCTIVE
}

enum AiActionStatus {
  PENDING
  EXECUTING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
  CONFLICTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relations
  reservations     Reservation[]
  reminders        Reminder[]
  aiPendingActions AiPendingAction[]
  aiWorkflowDrafts AiWorkflowDraft[]
}

model AiWorkflowDraft {
  id          String   @id @default(cuid())
  userId      String
  kind        String   @db.VarChar(40)
  payloadJson Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([expiresAt])
}

model AiPendingAction {
  id                String         @id @default(cuid())
  userId            String
  actionType        AiActionType
  riskLevel         AiActionRisk
  status            AiActionStatus @default(PENDING)
  payloadJson       Json
  previewJson       Json
  preconditionJson  Json
  confirmationLabel String         @db.VarChar(120)
  idempotencyKey    String         @unique
  expiresAt         DateTime
  confirmedAt       DateTime?
  executedAt        DateTime?
  resultJson        Json?
  failureCode       String?        @db.VarChar(64)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model Reservation {
  id        String @id @default(cuid())
  userEmail String
  user      User   @relation(fields: [userEmail], references: [email])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  startAt     DateTime
  endAt       DateTime?
  pickupText  String?
  dropoffText String?
  pax         Int       @default(1)
  priceEuro   Float? // <- keep FLOAT to match prod
  notes       String?

  phone  String? @db.VarChar(40)
  flight String? @db.VarChar(40)

  status    ResStatus @default(PENDING)
  isDeleted Boolean   @default(false) // ✅ added field

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders         Reminder[]
  commissionEntries CommissionEntry[]

  @@index([driverId])
}

model Driver {
  id                 String             @id @default(cuid())
  name               String
  licenseNumber      String
  vehicleType        DriverVehicleType?
  subscriptionExempt Boolean            @default(false)
  status             DriverStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reservations        Reservation[]
  commissionEntries   CommissionEntry[]
  payments            DriverPayment[]
  subscriptionCharges DriverSubscriptionCharge[]

  @@index([licenseNumber])
}

model CommissionEntry {
  id                String   @id @default(cuid())
  driverId          String
  reservationId     String?  @unique
  manualPickupText  String?
  manualDropoffText String?
  commissionAmount  Decimal  @db.Decimal(10, 2)
  entryDate         DateTime
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([driverId, entryDate])
}

model DriverPayment {
  id          String              @id @default(cuid())
  driverId    String
  paymentDate DateTime
  amount      Decimal             @db.Decimal(10, 2)
  method      DriverPaymentMethod
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, paymentDate])
}

model DriverSubscriptionCharge {
  id          String   @id @default(cuid())
  driverId    String
  chargeMonth DateTime @db.Date
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([driverId, chargeMonth])
  @@index([chargeMonth])
}

model Reminder {
  id        String @id @default(cuid())
  userEmail String
  user      User   @relation(fields: [userEmail], references: [email])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  title  String
  note   String?
  dueAt  DateTime
  isDone Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, dueAt])
}

model EmailThread {
  id            String         @id @default(cuid())
  subject       String?
  customerEmail String?
  customerName  String?
  lastMessageAt DateTime?
  unread        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      EmailMessage[]

  @@index([lastMessageAt])
  @@index([unread, lastMessageAt])
}

model EmailMessage {
  id           String            @id @default(cuid())
  threadId     String
  messageId    String            @unique
  inReplyTo    String?
  referenceIds String[]          @default([])
  fromEmail    String?
  fromName     String?
  toEmails     String?
  ccEmails     String?
  subject      String?
  bodyHtml     String?
  bodyText     String?
  direction    EmailDirection
  folder       String?
  folders      String[]          @default([])
  mailbox      String?
  mailboxes    String[]          @default([])
  imapUid      Int?
  receivedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  thread       EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments  EmailAttachment[]

  @@index([threadId, receivedAt])
  @@index([threadId, sentAt])
  @@index([inReplyTo])
  @@index([folder, createdAt])
  @@index([folders], type: Gin)
  @@index([mailbox, imapUid])
  @@index([mailboxes], type: Gin)
}

model EmailAttachment {
  id          String       @id @default(cuid())
  messageId   String
  filename    String
  mimeType    String?
  size        Int?
  storagePath String?
  createdAt   DateTime     @default(now())
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model EmailSyncState {
  id          String   @id @default(cuid())
  mailbox     String   @unique
  uidValidity BigInt
  lastUid     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  userEmail  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userEmail])
  @@index([entityType])
  @@index([action])
}
