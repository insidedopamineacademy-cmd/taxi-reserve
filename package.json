{
  "name": "taxi-reserve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3001",
    "migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:validate": "dotenv -e .env.local -- prisma validate",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "test:driver-subscriptions": "node --conditions=react-server --experimental-transform-types scripts/test-driver-subscriptions.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "chrono-node": "^2.8.4",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "imapflow": "^1.4.3",
    "mailparser": "^3.9.12",
    "next": "^15.5.18",
    "next-auth": "^4.24.14",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.5",
    "smtp-nodemailer": "npm:nodemailer@^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "dotenv-cli": "^8.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "nodemailer": "9.0.1"
  }
}
